# Copy to .env and fill in. Never commit .env.

# --- Meta Model API (required) ---
META_MODEL_API_KEY=
META_MODEL_API_BASE_URL=https://api.meta.ai/v1

# Model IDs are UNVERIFIED placeholders. Confirm with:
#   curl -s $META_MODEL_API_BASE_URL/models -H "Authorization: Bearer $META_MODEL_API_KEY"
MUSE_SPARK_MODEL=muse-spark-1.3
MUSE_IMAGE_MODEL=muse-image-1.0
SAM_MODEL=sam-3.1

# --- ComfyUI (Ad Creative Studio variants only) ---
COMFYUI_BASE_URL=http://127.0.0.1:8188
# Only needed for a hosted ComfyUI endpoint
COMFYUI_API_KEY=

# --- Meta Marketing API (stretch goal; Bid Advisor uses CSV upload by default) ---
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# --- Crawler ---
CRAWLER_USER_AGENT=MetaSMBGTM/0.1 (+https://github.com/nav-tej/meta-smb-gtm)
CRAWLER_MAX_URLS=5000

# --- App ---
OUTPUT_DIR=outputs
LOG_LEVEL=INFO
