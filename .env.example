# Copy to .env and fill in. Never commit .env.

# --- Meta Model API (required) ---
META_MODEL_API_KEY=
META_MODEL_API_BASE_URL=https://api.meta.ai/v1

# Model IDs verified 2026-11-03 against GET /v1/models (also lists muse-spark-1.2,
# muse-spark-1.1, muse-wonder-1.0, muse-voice-transcribe-1.0). Re-check with:
#   curl -s $META_MODEL_API_BASE_URL/models -H "Authorization: Bearer $META_MODEL_API_KEY"
MUSE_SPARK_MODEL=muse-spark-1.3
MUSE_IMAGE_MODEL=muse-image-1.0
SAM_MODEL=sam-3.1

# --- ComfyUI (Ad Creative Studio variants only) ---
COMFYUI_BASE_URL=http://127.0.0.1:8188
# Only needed for a hosted ComfyUI endpoint
COMFYUI_API_KEY=

# --- Meta Marketing API (stretch goal; Bid Advisor uses CSV upload by default) ---
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# --- Crawler ---
CRAWLER_USER_AGENT=MetaSMBGTM/0.1 (+https://github.com/nav-tej/meta-smb-gtm)
CRAWLER_MAX_URLS=5000

# --- App ---
OUTPUT_DIR=outputs
LOG_LEVEL=INFO

# --- Demo mode (public deployments) ---
# true: endpoints that call Muse return saved live results from data/samples/.
# Live calls need ?live=true and header X-Demo-Key: <DEMO_KEY>, capped per hour.
# Set DEMO_MODE=false for the full local version.
DEMO_MODE=true
DEMO_KEY=
LIVE_CALLS_PER_HOUR=5

# --- Result cache (24h) ---
# Route results and every individual Muse call (chat, image, SAM, voice) are cached on disk,
# keyed by endpoint + a hash of the exact parameters. On Vercel this is /tmp (per instance,
# lost on cold start), so hits there are best-effort.
RESULT_CACHE_ENABLED=true
RESULT_CACHE_DIR=data/cache
RESULT_CACHE_TTL_SECONDS=86400

# --- Server-side run credits ---
# Every live Muse request reserves 1 credit before any billed call; cache hits, failures and
# fallbacks refund it. Browsers start at TRIAL_RUNS, X-Demo-Key requests share PRESENTER_CREDITS.
# On Vercel the ledger is in /tmp (per instance). ACCOUNTS_REQUIRED uses Supabase instead.
CREDITS_ENABLED=true
CREDITS_DIR=data/credits
PRESENTER_CREDITS=20
MAX_CREDIT_BALANCE=5000
# Use false only for plain-http local testing in browsers that drop Secure cookies.
# (ACCOUNT_COOKIE_SECURE below also applies to the credit cookie.)

# --- Competitor monitor (public crawl only, no Muse call) ---
MONITOR_DIR=data/monitor
MONITOR_COOLDOWN_SECONDS=21600
# Optional: Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" when set.
CRON_SECRET=

# --- Experimental accounts (deferred in the scoped public demo) ---
# Keep false until Google OAuth, schema and the full session/quota flow are verified.
ACCOUNTS_REQUIRED=false
TRIAL_RUNS=3
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
APP_URL=https://meta-smb-gtm.vercel.app
ACCOUNT_COOKIE_SECURE=true
# Reserved billing settings; purchases are deferred and have no public UI.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Muse Starter subscription: create with `python scripts/stripe_setup.py` (lookup keys
# muse_starter_monthly / muse_starter_annual). Growth/Unlimited are hidden until priced.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_UNLIMITED=
