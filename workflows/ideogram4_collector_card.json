{
  "_meta": {
    "title": "Ideogram v4 Int8 Open-Weight Collector Typography Card + SAM 3.1 Composite",
    "description": "Open-weight Ideogram v4 Int8 workflow (from ComfyUI template image_ideogram4_t2i_int8) using ideogram4_int8_convrot.safetensors, qwen3vl_8b_fp8_scaled.safetensors (type ideogram4), and flux2-vae.safetensors for sharp collector typography and framing.",
    "template_source": "image_ideogram4_t2i_int8"
  },
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "artwork_input.png"
    }
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "sam3_mask.png"
    }
  },
  "3": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "ideogram4_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "4": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_8b_fp8_scaled.safetensors",
      "type": "ideogram4",
      "device": "default"
    }
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "flux2-vae.safetensors"
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "Museum collector exhibition frame in a warm modern living room with subtle gallery plaque reading '18K GOLD EMBELLISHED EDITION - SIGNED BY SARABJIT SINGH'",
      "clip": ["4", 0]
    }
  },
  "7": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": {
      "width": 1080,
      "height": 1350,
      "batch_size": 1
    }
  },
  "8": {
    "class_type": "Ideogram4Scheduler",
    "inputs": {
      "steps": 20,
      "width": 1080,
      "height": 1350,
      "mu": 0.5
    }
  },
  "9": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["3", 0],
      "positive": ["6", 0],
      "negative": ["6", 0],
      "latent_image": ["7", 0],
      "seed": 42,
      "steps": 20,
      "cfg": 3.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0
    }
  },
  "10": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["9", 0],
      "vae": ["5", 0]
    }
  },
  "11": {
    "class_type": "ImageToMask",
    "inputs": {
      "image": ["2", 0],
      "channel": "red"
    }
  },
  "12": {
    "class_type": "ImageCompositeMasked",
    "inputs": {
      "destination": ["10", 0],
      "source": ["1", 0],
      "mask": ["11", 0],
      "x": 0,
      "y": 0,
      "resize_source": false
    }
  },
  "13": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["12", 0],
      "filename_prefix": "meta_smb_ideogram4_card"
    }
  }
}
