{
  "_meta": {
    "title": "LTX-2.5 DFR (Diffusion Fidelity Rendering) Image-to-Video + Audio",
    "description": "Open-weight LTX-2.5 DFR workflow (from ComfyUI template video_ltx2_5_dfr_i2v) using ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors, gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors, ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors, ltx-2.5-22b-ic-lora-pixel-spatial-upscaler-x2-1.0.safetensors, ltx-2.5-video-vae-bf16.safetensors, and ltx-2.5-audio-vae-bf16.safetensors.",
    "template_source": "video_ltx2_5_dfr_i2v"
  },
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "base_creative.png"
    }
  },
  "2": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "3": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["2", 0],
      "lora_name": "ltx-2.5-22b-ic-lora-pixel-spatial-upscaler-x2-1.0.safetensors",
      "strength_model": 1.0
    }
  },
  "4": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
      "type": "ltxv",
      "device": "default"
    }
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ltx-2.5-video-vae-bf16.safetensors"
    }
  },
  "6": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ltx-2.5-audio-vae-bf16.safetensors"
    }
  },
  "7": {
    "class_type": "LatentUpscaleModelLoader",
    "inputs": {
      "model_name": "ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors"
    }
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "Slow cinematic dolly camera glide toward the framed painting in a sunlit luxury living room, warm afternoon light catching the 18k gold leaf texture, gentle acoustic gallery ambience",
      "clip": ["4", 0]
    }
  },
  "9": {
    "class_type": "LTXVImgToVideoInplace",
    "inputs": {
      "model": ["3", 0],
      "positive": ["8", 0],
      "vae": ["5", 0],
      "image": ["1", 0],
      "width": 1080,
      "height": 1920,
      "length": 121,
      "fps": 24,
      "strength": 1.0,
      "bypass": false
    }
  },
  "10": {
    "class_type": "LTXVLatentUpsampler",
    "inputs": {
      "samples": ["9", 0],
      "upscale_model": ["7", 0]
    }
  },
  "11": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": ["10", 0],
      "vae": ["5", 0],
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 64,
      "temporal_overlap": 8
    }
  },
  "12": {
    "class_type": "LTXVAudioVAEDecode",
    "inputs": {
      "samples": ["10", 0],
      "audio_vae": ["6", 0]
    }
  },
  "13": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["11", 0],
      "audio": ["12", 0],
      "fps": 24,
      "color_space": "sRGB"
    }
  },
  "14": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["13", 0],
      "filename_prefix": "meta_smb_ltx2_5_dfr_reel",
      "format": "mp4",
      "codec": "h264"
    }
  }
}
