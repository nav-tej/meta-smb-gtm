{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{src,data/samples}/**"
    }
  },
  "headers": [
    {
      "source": "/(static|samples)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/monitor/run",
      "schedule": "0 14 * * 1"
    },
    {
      "path": "/api/v1/digest/send",
      "schedule": "0 15 * * 1"
    }
  ]
}
